{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./packages",
    "module": "commonjs",
    "target": "es6",
    "lib": [
      "es2015",
      "dom",
      "dom.iterable",
      "webworker.importscripts",
      "scripthost",
      "es2022.error"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
